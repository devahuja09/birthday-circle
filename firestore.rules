// firestore.rules
// Deploy these in Firebase Console > Firestore > Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Groups: any logged-in user can read, only creator can delete
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // GroupMembers: members can read, any logged-in user can join
    match /groupMembers/{memberId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // BirthdayWishes: members of the group can read/write
    match /birthdayWishes/{wishId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.senderUserId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.senderUserId == request.auth.uid;
    }
  }
}
